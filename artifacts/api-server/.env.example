# ----------------------------------------------------------------------------
# dontalk api-server — required and optional environment variables
#
# Copy to .env (gitignored) for local dev, or set in Railway's Variables tab
# for production. Every value below is also enforced at runtime by the
# corresponding module — startup fails fast if a required var is missing.
# ----------------------------------------------------------------------------

# ----- server -----
# Listening port. Required by src/index.ts — startup throws if missing.
# Dockerfile defaults to 8080; Railway auto-assigns and exposes PORT, so
# you can usually rely on the platform-provided value and not set this.
# PORT=8080

# Production mode flips pino to JSON output and enables trust-proxy=1
# (already hard-coded in src/app.ts).
NODE_ENV=production

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ----- database -----
# Postgres connection string. lib/db/src/index.ts throws if missing.
# On Railway: leave this blank and link the Postgres service. Railway
# auto-injects DATABASE_URL into every service in the same project.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ----- admin / operator auth -----
# Shared secret for privileged endpoints (admin/markets/stock/rebalance/
# screeners/filters/etf_holdings write actions). Required for the admin UI
# to function. Generate with: openssl rand -hex 32
STOCK_OPERATOR_PASSWORD=replace-me-with-a-long-random-secret

# ----- email (transactional mail via nodemailer) -----
# Optional. lib/email.ts no-ops gracefully if these are missing (the daily
# signal-email feature silently skips), so you can leave them blank and
# fill in later.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown in the "From:" header. Defaults to SMTP_USER if unset.
# MAIL_FROM=alerts@example.com

# ----- supabase (contact form) -----
# Optional — routes/contact.ts has hard-coded fallbacks, so you can leave
# these unset and the public contact form still works. Override only if you
# migrate the Supabase project.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
